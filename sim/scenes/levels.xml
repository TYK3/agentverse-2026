    <geom name="wall_w" type="box" pos="-0.0400 1.2000 -0.2000" size="0.0400 1.2000 1.6000" rgba="0.8 0.7 0.5 1"/>
    <geom name="wall_e" type="box" pos="5.0400 1.2000 -0.2000" size="0.0400 1.2000 1.6000" rgba="0.8 0.7 0.5 1"/>
    <geom name="b2_floor_w" type="box" pos="0.7500 1.2000 -1.2300" size="0.7500 1.2000 0.0300" rgba="0.5 0.5 0.5 1"/>
    <geom name="b2_floor_m" type="box" pos="3.0000 1.5000 -1.2300" size="1.5000 0.9000 0.0300" rgba="0.5 0.5 0.5 1"/>
    <geom name="b2_floor_e" type="box" pos="4.7500 1.2000 -1.2300" size="0.2500 1.2000 0.0300" rgba="0.5 0.5 0.5 1"/>
    <geom name="ramp_r4" type="box" pos="3.5086 0.3000 -1.5287" size="1.0540 0.3000 0.0300" euler="0 -16.6992 0" rgba="0.45 0.55 0.6 1"/>
    <geom name="r4_side" type="box" pos="3.5000 0.6400 -1.4000" size="1.0000 0.0400 0.4000" rgba="0.8 0.7 0.5 1"/>
    <geom name="r4_end_rail" type="box" pos="2.0000 0.6400 -1.1300" size="0.5000 0.0400 0.1300" rgba="0.8 0.7 0.5 1"/>
