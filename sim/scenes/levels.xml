    <geom name="r2_side" type="box" pos="2.5000 1.7600 0.4000" size="1.0000 0.0400 0.4000" rgba="0.8 0.7 0.5 1"/>
    <geom name="r2_back" type="box" pos="1.5400 2.1000 0.2700" size="0.0400 0.3000 0.2700" rgba="0.8 0.7 0.5 1"/>
    <geom name="b20_rubble" type="box" pos="4.4000 1.1500 0.0750" size="0.2000 0.1500 0.0750" rgba="0.55 0.5 0.45 1"/>
    <geom name="b21_rubble" type="box" pos="1.0500 1.0500 -0.5400" size="0.1500 0.1500 0.0600" rgba="0.55 0.5 0.45 1"/>
    <geom name="b22_rubble" type="box" pos="2.1500 1.0500 -1.1400" size="0.1500 0.1500 0.0600" rgba="0.55 0.5 0.45 1"/>
    <geom name="b23_rubble" type="box" pos="3.6500 1.3500 -1.7400" size="0.1500 0.1500 0.0600" rgba="0.55 0.5 0.45 1"/>
    <!-- Casualty c1 in B1: a fixed visual marker, no collisions. -->
    <body name="casualty_c1" pos="0.45 1.9 -0.48" euler="0 90 0">
      <geom name="c1_g" type="capsule" size="0.1 0.25" contype="0" conaffinity="0" rgba="1 0.3 0.3 1"/>
    </body>
    <!-- Casualty c2 in B2: a fixed visual marker, no collisions. -->
    <body name="casualty_c2" pos="0.45 0.4 -1.08" euler="0 90 0">
      <geom name="c2_g" type="capsule" size="0.1 0.25" contype="0" conaffinity="0" rgba="1 0.3 0.3 1"/>
    </body>
    <!-- Casualty c3 in B3: a fixed visual marker, no collisions. -->
    <body name="casualty_c3" pos="0.45 2.0 -1.68" euler="0 90 0">
      <geom name="c3_g" type="capsule" size="0.1 0.25" contype="0" conaffinity="0" rgba="1 0.3 0.3 1"/>
    </body>
    <!-- Scout as in backup.xml: mocap, origin = sensor origin 0.075 m above the floor, robot geoms in
         group 3. It starts on L1; sim/levels.py sets its height from the floor under it. -->
    <body name="scout" mocap="true" pos="0.5 0.5 0.675">
      <geom name="scout_chassis" type="box" size="0.1 0.08 0.04" pos="0 0 -0.035" group="3" contype="0" conaffinity="0" rgba="0.2 0.5 0.9 1"/>
      <geom name="scout_mast" type="cylinder" size="0.02 0.02" pos="0 0 0.02" group="3" contype="0" conaffinity="0" rgba="0.1 0.1 0.1 1"/>
      <camera name="scout_cam" pos="0.1 0 0.03" xyaxes="0 -1 0 0 0 1" fovy="60"/>
    </body>
    <!-- Responder as in backup.xml: mocap, centre 0.05 m above the floor, geoms in group 3. It starts in L1's
         north-west corner facing east, out of the Scout's way (its forward rays see every group); sim/responder.py follows the floor under it (z and pitch) down the ramps. Its kit,
         radio and water are free bodies held by the carry_* welds; they are group 3 too, so the Scout's
         LiDAR and floor probe never see them and its runs stay as before. Its start (0.225, 2.175) is a 5 cm
         cell centre, 0.225 m from wall_n: a route that begins at its own cell then pulls it nowhere (at
         0.2, 2.25, on a cell corner 0.15 m from the wall, the first cell centre steered it into wall_n). -->
    <body name="responder" mocap="true" pos="0.225 2.175 0.65">
      <geom name="responder_chassis" type="box" size="0.16 0.07 0.05" group="3" contype="0" conaffinity="0" rgba="0.95 0.6 0.1 1"/>
      <geom name="responder_gripper" type="box" size="0.02 0.06 0.015" pos="0.17 0 0.03" group="3" contype="0" conaffinity="0" rgba="0.15 0.15 0.15 1"/>
    </body>
    <body name="water" pos="0.125 2.175 0.76"><freejoint/><geom name="water_supply" type="cylinder" size="0.035 0.06" mass="0.5" group="3" rgba="0.2 0.55 1 1"/></body>
    <body name="first_aid_kit" pos="0.225 2.175 0.73"><freejoint/><geom name="first_aid_kit_supply" type="box" size="0.05 0.035 0.03" mass="0.4" group="3" rgba="0.9 0.15 0.15 1"/></body>
    <body name="radio" pos="0.325 2.175 0.745"><freejoint/><geom name="radio_supply" type="box" size="0.025 0.02 0.045" mass="0.3" group="3" rgba="0.15 0.15 0.15 1"/></body>
    <camera name="overview" pos="2.5 -3.5 3.2" xyaxes="1 0 0 0 0.6 0.8"/>
  </worldbody>
  <equality>
    <!-- The Responder sets out loaded, as in backup.xml. -->
    <weld name="carry_water" body1="responder" body2="water" active="true"/>
    <weld name="carry_first_aid_kit" body1="responder" body2="first_aid_kit" active="true"/>
    <weld name="carry_radio" body1="responder" body2="radio" active="true"/>
  </equality>
</mujoco>
