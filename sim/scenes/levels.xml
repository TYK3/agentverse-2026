<!--
  L4 multi-level scene, written by sim/scenes/make_levels.py (edit that, not this file).
  A mezzanine L1 (floor z = +0.6), the ground floor (z = 0) and basements B1 (z = -0.6), B2 (z = -1.2).

  Plan view (x right, y up), footprint 5 m x 2.4 m:
     y=2.4 +-------------------------------------------+
           | L1 (x<1.5) |== ramp R2: L1 -> ground ==> |   y 1.8..2.4, x 1.5 -> 3.5, side wall at y = 1.8
     y=1.8 | edge rail  |                             |
           |            |   ground floor              |
     y=0.6 |            | <== ramp R1: ground -> B1 ==|   y 0..0.6, x 3.5 -> 1.5, railed shaft
     y=0   +-------------------------------------------+
         x=0         x=1.5                  x=3.5    x=5
  B1 lies under the whole footprint; R1 lands on it at x = 1.5. Casualty c1 lies in B1 at the west end.

  B1 plan view: ramp R3 (B1 -> B2) runs east over y 1.8..2.4, x 2.5 -> 4.5, in a railed shaft that is open
  down to B2 for x 2.5..5. B2 lies under the whole footprint; the Scout leaves R3's foot (x 4.5..5) south,
  under the rail at y = 1.8, which is 0.54 m above B2. Casualty c2 lies in B2 at the west end.
  Every drop is railed (0.2 m) except the ramp mouths, because a 2D LiDAR cannot see a drop.
  Levels are static geoms, not b<number> blocks, so the aftershock check has nothing to shake here.
-->
<mujoco model="aftershock_levels">
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <visual><global offwidth="1280" offheight="960"/></visual>
  <default><geom friction="1 0.005 0.0001"/></default>
  <worldbody>
    <light name="sun" pos="2.5 1.2 6" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8"/>
    <body name="ground" mocap="true" pos="0 0 0"/>
    <geom name="b2_floor" type="box" pos="2.5000 1.2000 -1.2300" size="2.5000 1.2000 0.0300" rgba="0.5 0.5 0.5 1"/>
    <geom name="wall_s" type="box" pos="2.5000 -0.0400 0.1000" size="2.5400 0.0400 1.3000" rgba="0.8 0.7 0.5 1"/>
    <geom name="wall_n" type="box" pos="2.5000 2.4400 0.1000" size="2.5400 0.0400 1.3000" rgba="0.8 0.7 0.5 1"/>
    <geom name="wall_w" type="box" pos="-0.0400 1.2000 0.1000" size="0.0400 1.2000 1.3000" rgba="0.8 0.7 0.5 1"/>
    <geom name="wall_e" type="box" pos="5.0400 1.2000 0.1000" size="0.0400 1.2000 1.3000" rgba="0.8 0.7 0.5 1"/>
    <geom name="b1_floor_s" type="box" pos="2.5000 0.9000 -0.6300" size="2.5000 0.9000 0.0300" rgba="0.5 0.5 0.5 1"/>
    <geom name="b1_floor_nw" type="box" pos="1.2500 2.1000 -0.6300" size="1.2500 0.3000 0.0300" rgba="0.5 0.5 0.5 1"/>
    <geom name="ramp_r3" type="box" pos="3.4914 2.1000 -0.9287" size="1.0540 0.3000 0.0300" euler="0 16.6992 0" rgba="0.45 0.55 0.6 1"/>
    <geom name="r3_side" type="box" pos="3.5000 1.7600 -0.8000" size="1.0000 0.0400 0.4000" rgba="0.8 0.7 0.5 1"/>
    <geom name="r3_end_rail" type="box" pos="4.7500 1.7600 -0.5300" size="0.2500 0.0400 0.1300" rgba="0.8 0.7 0.5 1"/>
    <geom name="r3_back" type="box" pos="2.4600 2.1000 -0.9300" size="0.0400 0.3000 0.2700" rgba="0.8 0.7 0.5 1"/>
    <geom name="g_floor_w" type="box" pos="0.7500 1.2000 -0.0300" size="0.7500 1.2000 0.0300" rgba="0.5 0.5 0.5 1"/>
