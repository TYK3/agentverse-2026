<!--
  AFTERSHOCK hand-built backup scene (T03, issue #11).

  A collapsed three-room building on a 6 m x 6 m floor. Units are metres, z is up.
  Every wall and rubble block is its own free body named b<number>; its geom is named
  b<number>_<label> so sim/scene.py can read the label (wall or rubble).

  Plan view (x to the right, y up), wall line positions:
      y=1.5   +=====================================+  b5 north wall
              |  room 1      |  room 2   |  room 3  |
              |              b7          b9    c1   |
              |    doorway   .           .  gap +   |
              |    y 0..0.5  .           .  rubble  |
              |              b6          b8   b11   |
      y=-1.0  +===  breach  ===========================+  b3, b4 south wall
             x=-1.5  (x -1.0..-0.4)  x=0      x=1.25    x=2.5
  The Scout enters room 1 through the breach in the south wall, passes the 0.5 m doorway
  into room 2, then the partly blocked 0.6 m gap into room 3 where casualty c1 lies.
  Small gaps (5 mm) between touching walls keep free bodies from starting in contact.
-->
<mujoco model="aftershock_backup">
  <!-- noslip_iterations stops soft-contact creep: without it the leaning slab b10 slides ~1 cm per 10 s. -->
  <option timestep="0.002" gravity="0 0 -9.81" noslip_iterations="3"/>

  <visual>
    <global offwidth="1280" offheight="960"/>
  </visual>

  <default>
    <geom friction="1 0.005 0.0001"/>
  </default>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.35 0.4 0.45" rgb2="0.05 0.05 0.08" width="256" height="256"/>
  </asset>

  <worldbody>
    <light name="sun" pos="0.5 0 6" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8"/>

    <!-- Ground: a mocap body the aftershock moves with data.mocap_pos (T05). Moving a mocap body gives it
         no velocity, so friction would never drag the blocks; the floor is therefore a dynamic plate welded
         to the mocap (see <equality>), which does carry velocity. gravcomp keeps the weld from sagging. -->
    <body name="ground" mocap="true" pos="0 0 0"/>
    <body name="plate" pos="0 0 0" gravcomp="1">
      <freejoint/>
      <geom name="floor" type="box" size="3 3 0.05" pos="0 0 -0.05" density="100" rgba="0.5 0.5 0.5 1"/>
    </body>

    <!-- Outer walls. label: wall -->
    <body name="b1" pos="-1.5 0.25 0.5"><freejoint/><geom name="b1_wall" type="box" size="0.05 1.3 0.5" rgba="0.8 0.7 0.5 1"/></body>   <!-- west -->
    <body name="b2" pos="2.5 0.25 0.5"><freejoint/><geom name="b2_wall" type="box" size="0.05 1.3 0.5" rgba="0.8 0.7 0.5 1"/></body>    <!-- east -->
    <body name="b3" pos="-1.2225 -1.0 0.5"><freejoint/><geom name="b3_wall" type="box" size="0.2225 0.05 0.5" rgba="0.8 0.7 0.5 1"/></body>  <!-- south, west of breach -->
    <body name="b4" pos="1.0225 -1.0 0.5"><freejoint/><geom name="b4_wall" type="box" size="1.4225 0.05 0.5" rgba="0.8 0.7 0.5 1"/></body>   <!-- south, east of breach -->
    <body name="b5" pos="0.5 1.5 0.5"><freejoint/><geom name="b5_wall" type="box" size="1.445 0.05 0.5" rgba="0.8 0.7 0.5 1"/></body>       <!-- north -->

    <!-- Interior wall between rooms 1 and 2, doorway 0.5 m wide (y 0.0 to 0.5). label: wall -->
    <body name="b6" pos="0 -0.4725 0.5"><freejoint/><geom name="b6_wall" type="box" size="0.05 0.4725 0.5" rgba="0.75 0.65 0.45 1"/></body>
    <body name="b7" pos="0 0.9725 0.5"><freejoint/><geom name="b7_wall" type="box" size="0.05 0.4725 0.5" rgba="0.75 0.65 0.45 1"/></body>

    <!-- Interior wall between rooms 2 and 3, gap 0.6 m wide (y 0.3 to 0.9), partly blocked by b11. label: wall -->
    <body name="b8" pos="1.25 -0.3225 0.5"><freejoint/><geom name="b8_wall" type="box" size="0.05 0.6225 0.5" rgba="0.75 0.65 0.45 1"/></body>
    <body name="b9" pos="1.25 1.1725 0.5"><freejoint/><geom name="b9_wall" type="box" size="0.05 0.2725 0.5" rgba="0.75 0.65 0.45 1"/></body>

    <!-- Rubble. label: rubble -->
    <!-- b10: slab leaning at 60 degrees against b8 in room 2 (bottom on the floor, top on the wall face x=1.2) -->
    <body name="b10" pos="0.974 -0.5 0.3614" euler="0 -60 0"><freejoint/><geom name="b10_rubble" type="box" size="0.4 0.2 0.03" density="600" rgba="0.55 0.5 0.45 1"/></body>
    <!-- b11: light block in the room 2/3 gap, leaves about 0.33 m free; the Responder can clear it -->
    <body name="b11" pos="1.25 0.45 0.08"><freejoint/><geom name="b11_rubble" type="box" size="0.08 0.12 0.08" mass="1.5" rgba="0.6 0.45 0.35 1"/></body>
    <!-- b12, b13: a small pile inside the breach in room 1 -->
    <body name="b12" pos="-0.7 -0.6 0.1"><freejoint/><geom name="b12_rubble" type="box" size="0.1 0.1 0.1" density="600" rgba="0.55 0.5 0.45 1"/></body>
    <body name="b13" pos="-0.7 -0.6 0.25"><freejoint/><geom name="b13_rubble" type="box" size="0.08 0.08 0.05" density="600" rgba="0.6 0.55 0.5 1"/></body>
    <!-- b14: a fallen wall section lying flat in room 3 -->
    <body name="b14" pos="1.9 -0.4 0.04"><freejoint/><geom name="b14_rubble" type="box" size="0.35 0.1 0.04" density="600" rgba="0.7 0.6 0.45 1"/></body>
    <!-- b15: block against the north-west corner of room 1 -->
    <body name="b15" pos="-1.0 1.2 0.1"><freejoint/><geom name="b15_rubble" type="box" size="0.12 0.1 0.1" density="600" rgba="0.55 0.5 0.45 1"/></body>

    <!-- Casualty marker c1, lying in room 3. No collisions, no joint: a fixed visual marker only. -->
    <body name="casualty_c1" pos="2.0 1.0 0.12" euler="0 90 0">
      <geom name="c1_g" type="capsule" size="0.12 0.3" contype="0" conaffinity="0" rgba="1 0.3 0.3 1"/>
    </body>

    <!-- Spare rubble for the unscripted change (sim/inject.py, T05): parked under the floor with no
         collisions and gravity compensated, then dropped into place on POST /inject block_added.
         Not named b<number>, so scene/loaded leaves it out until it is used. -->
    <body name="x1" pos="0 0 -1" gravcomp="1">
      <freejoint/>
      <geom name="x1_rubble" type="box" size="0.1 0.1 0.08" density="600" contype="0" conaffinity="0" rgba="0.65 0.4 0.3 1"/>
    </body>

    <!-- Scout rover (T04): a mocap body driven kinematically by sim/world.py. Its origin is the sensor
         origin (LiDAR height 0.075 m); it faces +x in its own frame and starts outside the breach facing +y.
         Its geoms do not collide, so it never shoves rubble; world.py refuses moves into occupied space. -->
    <body name="scout" mocap="true" pos="-0.5 -1.5 0.075" quat="0.7071068 0 0 0.7071068">
      <geom name="scout_chassis" type="box" size="0.1 0.08 0.04" pos="0 0 -0.035" contype="0" conaffinity="0" rgba="0.2 0.5 0.9 1"/>
      <geom name="scout_mast" type="cylinder" size="0.02 0.02" pos="0 0 0.02" contype="0" conaffinity="0" rgba="0.1 0.1 0.1 1"/>
      <camera name="scout_cam" pos="0.1 0 0.03" xyaxes="0 -1 0 0 0 1" fovy="60"/>
    </body>

    <!-- Responder (T06): the heavier robot, a mocap body driven cell by cell by sim/responder.py.
         Like the Scout its geoms do not collide; responder.py casts collision rays before every step
         and refuses to move into a block. It starts outside the breach, right behind the Scout (1 cm gap), facing +y:
         at y -1.77 its start is within 0.35 m of floor the Scout's first scans see (open ground further
         out stays unmapped, because a LiDAR beam that hits nothing marks no cells free).
         Narrow enough (0.14 m) to pass the breach between the b12/b13 pile and wall b4 (route cells at x = -0.475).
         Its geoms are in group 3 (robot geoms) so the Scout's sensors can leave them out of the map. -->
    <body name="responder" mocap="true" pos="-0.5 -1.77 0.05" quat="0.7071068 0 0 0.7071068">
      <geom name="responder_chassis" type="box" size="0.16 0.07 0.05" group="3" contype="0" conaffinity="0" rgba="0.95 0.6 0.1 1"/>
      <geom name="responder_gripper" type="box" size="0.02 0.06 0.015" pos="0.17 0 0.03" group="3" contype="0" conaffinity="0" rgba="0.15 0.15 0.15 1"/>
    </body>

    <!-- Supplies: small free bodies carried on the Responder's deck by the carry_* welds below.
         Positions here equal the deck slots (responder pose + slot), so nothing jumps at load. -->
    <body name="water" pos="-0.5 -1.87 0.16"><freejoint/><geom name="water_supply" type="cylinder" size="0.035 0.06" mass="0.5" rgba="0.2 0.55 1 1"/></body>
    <body name="first_aid_kit" pos="-0.5 -1.77 0.13"><freejoint/><geom name="first_aid_kit_supply" type="box" size="0.05 0.035 0.03" mass="0.4" rgba="0.9 0.15 0.15 1"/></body>
    <body name="radio" pos="-0.5 -1.67 0.145"><freejoint/><geom name="radio_supply" type="box" size="0.025 0.02 0.045" mass="0.3" rgba="0.15 0.15 0.15 1"/></body>

    <camera name="overview" pos="0.5 -4 3.5" xyaxes="1 0 0 0 0.6 0.8"/>
  </worldbody>

  <!-- Aftershock (T05): the plate follows the mocap ground; the outer shell b1-b5 is braced to the plate,
       so a shake of 0.015 m at 4 Hz fails the leaning slab b10 and the wall b8 it leans on, and nothing
       else moves more than 1 cm (sweep 0.012-0.018 m gives the same pair). Interior walls and rubble are free. -->
  <equality>
    <weld name="plate_to_ground" body1="plate" body2="ground" solref="0.004 1"/>
    <weld name="brace_b1" body1="b1" body2="plate"/>
    <weld name="brace_b2" body1="b2" body2="plate"/>
    <weld name="brace_b3" body1="b3" body2="plate"/>
    <weld name="brace_b4" body1="b4" body2="plate"/>
    <weld name="brace_b5" body1="b5" body2="plate"/>

    <!-- T06 gripper. carry_<item>: the Responder holds a supply (active at start: it sets out loaded).
         grip_<block>: one weld per light rubble block (< 2 kg) it may clear; responder.py sets the held
         pose and switches the weld on (grip) or off (release, the block falls). -->
    <weld name="carry_water" body1="responder" body2="water" active="true"/>
    <weld name="carry_first_aid_kit" body1="responder" body2="first_aid_kit" active="true"/>
    <weld name="carry_radio" body1="responder" body2="radio" active="true"/>
    <weld name="grip_b11" body1="responder" body2="b11" active="false"/>
    <weld name="grip_b13" body1="responder" body2="b13" active="false"/>
  </equality>
</mujoco>
