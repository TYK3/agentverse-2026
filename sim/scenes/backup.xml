<!--
  AFTERSHOCK hand-built backup scene (T03, issue #11).

  A collapsed three-room building on a 6 m x 6 m floor. Units are metres, z is up.
  Every wall and rubble block is its own free body named b<number>; its geom is named
  b<number>_<label> so sim/scene.py can read the label (wall or rubble).

  Plan view (x to the right, y up), wall line positions:
      y=1.5   +=====================================+  b5 north wall
              |  room 1      |  room 2   |  room 3  |
              |              b7          b9    c1   |
              |    doorway   .           .  gap +   |
              |    y 0..0.5  .           .  rubble  |
              |              b6          b8   b11   |
      y=-1.0  +===  breach  ===========================+  b3, b4 south wall
             x=-1.5  (x -1.0..-0.4)  x=0      x=1.25    x=2.5
  The Scout enters room 1 through the breach in the south wall, passes the 0.5 m doorway
  into room 2, then the partly blocked 0.6 m gap into room 3 where casualty c1 lies.
  Small gaps (5 mm) between touching walls keep free bodies from starting in contact.
-->
<mujoco model="aftershock_backup">
  <!-- noslip_iterations stops soft-contact creep: without it the leaning slab b10 slides ~1 cm per 10 s. -->
  <option timestep="0.002" gravity="0 0 -9.81" noslip_iterations="3"/>

  <visual>
    <global offwidth="1280" offheight="960"/>
  </visual>

  <default>
    <geom friction="1 0.005 0.0001"/>
  </default>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.35 0.4 0.45" rgb2="0.05 0.05 0.08" width="256" height="256"/>
  </asset>

  <worldbody>
    <light name="sun" pos="0.5 0 6" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8"/>

    <!-- Ground plate: a mocap body, so the aftershock can shake it by moving data.mocap_pos. -->
    <body name="ground" mocap="true" pos="0 0 0">
      <geom name="floor" type="box" size="3 3 0.05" pos="0 0 -0.05" rgba="0.5 0.5 0.5 1"/>
    </body>

    <!-- Outer walls. label: wall -->
    <body name="b1" pos="-1.5 0.25 0.5"><freejoint/><geom name="b1_wall" type="box" size="0.05 1.3 0.5" rgba="0.8 0.7 0.5 1"/></body>   <!-- west -->
    <body name="b2" pos="2.5 0.25 0.5"><freejoint/><geom name="b2_wall" type="box" size="0.05 1.3 0.5" rgba="0.8 0.7 0.5 1"/></body>    <!-- east -->
    <body name="b3" pos="-1.2225 -1.0 0.5"><freejoint/><geom name="b3_wall" type="box" size="0.2225 0.05 0.5" rgba="0.8 0.7 0.5 1"/></body>  <!-- south, west of breach -->
    <body name="b4" pos="1.0225 -1.0 0.5"><freejoint/><geom name="b4_wall" type="box" size="1.4225 0.05 0.5" rgba="0.8 0.7 0.5 1"/></body>   <!-- south, east of breach -->
    <body name="b5" pos="0.5 1.5 0.5"><freejoint/><geom name="b5_wall" type="box" size="1.445 0.05 0.5" rgba="0.8 0.7 0.5 1"/></body>       <!-- north -->

    <!-- Interior wall between rooms 1 and 2, doorway 0.5 m wide (y 0.0 to 0.5). label: wall -->
    <body name="b6" pos="0 -0.4725 0.5"><freejoint/><geom name="b6_wall" type="box" size="0.05 0.4725 0.5" rgba="0.75 0.65 0.45 1"/></body>
    <body name="b7" pos="0 0.9725 0.5"><freejoint/><geom name="b7_wall" type="box" size="0.05 0.4725 0.5" rgba="0.75 0.65 0.45 1"/></body>

    <!-- Interior wall between rooms 2 and 3, gap 0.6 m wide (y 0.3 to 0.9), partly blocked by b11. label: wall -->
    <body name="b8" pos="1.25 -0.3225 0.5"><freejoint/><geom name="b8_wall" type="box" size="0.05 0.6225 0.5" rgba="0.75 0.65 0.45 1"/></body>
    <body name="b9" pos="1.25 1.1725 0.5"><freejoint/><geom name="b9_wall" type="box" size="0.05 0.2725 0.5" rgba="0.75 0.65 0.45 1"/></body>

    <!-- Rubble. label: rubble -->
    <!-- b10: slab leaning at 60 degrees against b8 in room 2 (bottom on the floor, top on the wall face x=1.2) -->
    <body name="b10" pos="0.974 -0.5 0.3614" euler="0 -60 0"><freejoint/><geom name="b10_rubble" type="box" size="0.4 0.2 0.03" density="600" rgba="0.55 0.5 0.45 1"/></body>
    <!-- b11: light block in the room 2/3 gap, leaves about 0.33 m free; the Responder can clear it -->
    <body name="b11" pos="1.25 0.45 0.08"><freejoint/><geom name="b11_rubble" type="box" size="0.08 0.12 0.08" mass="1.5" rgba="0.6 0.45 0.35 1"/></body>
    <!-- b12, b13: a small pile inside the breach in room 1 -->
    <body name="b12" pos="-0.7 -0.6 0.1"><freejoint/><geom name="b12_rubble" type="box" size="0.1 0.1 0.1" density="600" rgba="0.55 0.5 0.45 1"/></body>
    <body name="b13" pos="-0.7 -0.6 0.25"><freejoint/><geom name="b13_rubble" type="box" size="0.08 0.08 0.05" density="600" rgba="0.6 0.55 0.5 1"/></body>
    <!-- b14: a fallen wall section lying flat in room 3 -->
    <body name="b14" pos="1.9 -0.4 0.04"><freejoint/><geom name="b14_rubble" type="box" size="0.35 0.1 0.04" density="600" rgba="0.7 0.6 0.45 1"/></body>
    <!-- b15: block against the north-west corner of room 1 -->
    <body name="b15" pos="-1.0 1.2 0.1"><freejoint/><geom name="b15_rubble" type="box" size="0.12 0.1 0.1" density="600" rgba="0.55 0.5 0.45 1"/></body>

    <!-- Casualty marker c1, lying in room 3. No collisions, no joint: a fixed visual marker only. -->
    <body name="casualty_c1" pos="2.0 1.0 0.12" euler="0 90 0">
      <geom name="c1_g" type="capsule" size="0.12 0.3" contype="0" conaffinity="0" rgba="1 0.3 0.3 1"/>
    </body>

    <!-- scout_cam: placeholder at the breach looking into room 1 (+y); T04 mounts it on the Scout. -->
    <camera name="scout_cam" pos="-0.7 -1.4 0.2" euler="90 0 0"/>
    <camera name="overview" pos="0.5 -4 3.5" xyaxes="1 0 0 0 0.6 0.8"/>
  </worldbody>
</mujoco>
